{
  "productName": "aiimage",
  "version": "0.1.0",
  "identifier": "com.aiimage.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "aiimage",
        "width": 1280,
        "height": 820,
        "minWidth": 750,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8765",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'"
      },
      "capabilities": [
        "default"
      ],
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8765 http://127.0.0.1:5173 ws://127.0.0.1:5173",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-eval'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": false
  }
}
